# Railway PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Generate three independent random secrets. FIELD_ENCRYPTION_KEY must decode to exactly 32 bytes.
SESSION_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters

# Railway private Storage Bucket credentials
S3_ENDPOINT=https://your-bucket-endpoint
S3_REGION=auto
S3_BUCKET=your-private-bucket-name
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Used once by `npm run db:seed`; remove ADMIN_INITIAL_PASSWORD afterward.
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-long-unique-password
ADMIN_TOTP_SECRET=replace-with-secret-from-your-authenticator-setup
